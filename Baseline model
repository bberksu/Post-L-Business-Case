@dataclass
class EvaluationResult:
    """
    Full cost/quality breakdown for a given set of open service points.

    Quick reference for optimizers
    ───────────────────────────────
    result.objective   — the scalar to minimise (cost + optional distance penalty)
    result.total_cost  — pure cost in €/year (no penalty)
    result.max_dist_km — worst-case customer distance (coverage proxy)
    result.n_open      — number of open SPs

    Comparing two solutions
    ───────────────────────
    Better solution has lower objective.  If lambda_dist=0, objective == total_cost.
    """
    # Scalar objectives
    objective:        float   # total_cost + lambda_dist × distance_penalty
    total_cost:       float   # € / year
    fixed_cost:       float   # n_open × €50,000
    delivery_cost:    float   # home deliveries × distance × €1.50/km
    storage_cost:     float   # pickups × 2 days × €0.10/pkg/day
    # Coverage
    max_dist_km:      float   # max road distance from any CBS square to its SP
    avg_dist_km:      float   # demand-weighted average distance to assigned SP
    # Volume
    total_pickups:    float
    total_deliveries: float
    pickup_rate_net:  float   # total_pickups / total_parcels
    # Configuration
    open_sp_indices:  List[int]
    open_sp_ids:      List[int]
    n_open:           int
    # SP-level breakdown (suppress in repr for readability)
    sp_detail:        pd.DataFrame = field(repr=False)

    def __str__(self) -> str:
        lines = [
            "─── EvaluationResult ───────────────────────────────────",
            f"  Open SPs   : {self.n_open} of 35",
            f"  Objective  : €{self.objective:>12,.0f}",
            f"  Total cost : €{self.total_cost:>12,.0f}",
            f"    Fixed    : €{self.fixed_cost:>12,.0f}  ({self.fixed_cost/self.total_cost:.1%})",
            f"    Delivery : €{self.delivery_cost:>12,.0f}  ({self.delivery_cost/self.total_cost:.1%})",
            f"    Storage  : €{self.storage_cost:>12,.0f}  ({self.storage_cost/self.total_cost:.1%})",
            f"  Max dist   : {self.max_dist_km:>8.2f} km",
            f"  Avg dist   : {self.avg_dist_km:>8.2f} km  (demand-weighted)",
            f"  Pickup rate: {self.pickup_rate_net:>8.1%}",
            "────────────────────────────────────────────────────────",
        ]
        return "\n".join(lines)


# ══════════════════════════════════════════════════════════════════════════════
# CORE EVALUATE FUNCTION  ← THE SHARED OBJECTIVE FUNCTION
# ══════════════════════════════════════════════════════════════════════════════

def evaluate(
    net: PostLNetwork,
    open_sp_indices: List[int],
    lambda_dist: float = 0.0,
    max_dist_threshold_km: Optional[float] = None,
) -> EvaluationResult:
    """
    Evaluate the total cost and service quality of a SP configuration.

    This is the **shared objective function** used by all optimisation methods.
    It is fully vectorised (numpy only — no graph calls) and runs in < 1 ms
    for any subset of the 35 SPs.

    Parameters
    ----------
    net : PostLNetwork
        Precomputed network.  Load once, pass everywhere.
    open_sp_indices : list[int]
        Column indices (0–34) of the SPs to open.
        Use net.ids_to_indices([4440, 1739, ...]) to convert Location IDs.
    lambda_dist : float, optional (default 0)
        Weight for the coverage penalty in the weighted objective:
            objective = total_cost
                      + lambda_dist
                        × Σ_squares  max(0, dist_km − threshold) × demand_sq
        Set lambda_dist=0 for pure cost optimisation (default).
        Typical values: 1e3 – 1e5 depending on desired cost/coverage balance.
    max_dist_threshold_km : float, optional
        Distance threshold above which a penalty is applied (km).
        Only used when lambda_dist > 0.
        Suggested value: 3.0 km (≈ acceptable walk to a service point).

    Returns
    -------
    EvaluationResult
        .objective        — scalar to minimise
        .total_cost       — annual cost (€)
        .max_dist_km      — worst-case customer distance (km)
        .sp_detail        — per-SP breakdown DataFrame

    Examples
    --------
    Pure cost minimisation:
        result = evaluate(net, [0, 3, 7, 12, 20])

    Cost + coverage (penalise squares > 3 km from nearest SP):
        result = evaluate(net, [0, 3, 7, 12, 20],
                          lambda_dist=1e4, max_dist_threshold_km=3.0)

    Compare against all-35-open baseline:
        ref    = baseline_all_open(net)
        result = evaluate(net, my_indices)
        saving = ref.total_cost - result.total_cost
    """
    if len(open_sp_indices) == 0:
        raise ValueError("open_sp_indices must contain at least one SP.")

    indices = np.array(open_sp_indices, dtype=int)
    n_sq    = net.n_squares
    dm      = net.dist_matrix   # (n_squares, 35), metres

    # ── 1. Assign each CBS square to its nearest open SP ──────────────────────
    sub         = dm[:, indices]                              # (n_sq, n_open) m
    local_col   = sub.argmin(axis=1)                          # (n_sq,) → index into `indices`
    dist_m      = sub[np.arange(n_sq), local_col]            # (n_sq,) metres
    dist_km     = dist_m / 1_000.0                            # (n_sq,) km

    # ── 2. Pickup rate per CBS square ─────────────────────────────────────────
    p_up        = pickup_rate(dist_km)                        # (n_sq,) ∈ [0, 1]

    # ── 3. Annual volume per CBS square ───────────────────────────────────────
    demand      = net.sq_demand                               # (n_sq,) parcels/yr
    pickups     = demand * p_up                               # (n_sq,)
    deliveries  = demand * (1.0 - p_up)                       # (n_sq,)

    # ── 4. Aggregate costs per open SP ───────────────────────────────────────
    sp_rows = []
    for local_j, global_j in enumerate(indices):
        mask = local_col == local_j

        if not mask.any():
            # Open SP with no CBS squares in catchment — still pays fixed cost
            sp_rows.append({
                "sp_index":          int(global_j),
                "sp_id":             net.sp_ids[global_j],
                "n_squares":         0,
                "annual_pickups":    0.0,
                "annual_deliveries": 0.0,
                "avg_dist_km":       0.0,
                "delivery_cost":     0.0,
                "storage_cost":      0.0,
                "fixed_cost":        float(FIXED_COST_EUR),
                "total_cost":        float(FIXED_COST_EUR),
                "cost_per_parcel":   float("inf"),
            })
            continue

        sq_dem   = demand[mask]
        sq_dist  = dist_km[mask]
        sq_pick  = pickups[mask]
        sq_del   = deliveries[mask]

        ann_pick = float(sq_pick.sum())
        ann_del  = float(sq_del.sum())

        # Delivery cost: parcel travels from SP to customer (distance proxy)
        del_cost  = float((sq_del * sq_dist * DELIVERY_EUR_PER_KM).sum())
        stor_cost = float(ann_pick * AVG_DWELL_DAYS * STORAGE_EUR_PKG_DAY)
        fix_cost  = float(FIXED_COST_EUR)
        tot_cost  = del_cost + stor_cost + fix_cost

        total_vol_sp = ann_pick + ann_del
        avg_d = float(np.average(sq_dist, weights=sq_dem)) if sq_dem.sum() > 0 else 0.0

        sp_rows.append({
            "sp_index":          int(global_j),
            "sp_id":             net.sp_ids[global_j],
            "n_squares":         int(mask.sum()),
            "annual_pickups":    ann_pick,
            "annual_deliveries": ann_del,
            "avg_dist_km":       avg_d,
            "delivery_cost":     del_cost,
            "storage_cost":      stor_cost,
            "fixed_cost":        fix_cost,
            "total_cost":        tot_cost,
            "cost_per_parcel":   tot_cost / max(total_vol_sp, 1.0),
        })

    sp_detail = pd.DataFrame(sp_rows)

    # ── 5. Network-level aggregates ───────────────────────────────────────────
    total_del   = float(deliveries.sum())
    total_pick  = float(pickups.sum())
    total_vol   = total_del + total_pick

    fixed_cost    = float(len(indices) * FIXED_COST_EUR)
    delivery_cost = float((deliveries * dist_km * DELIVERY_EUR_PER_KM).sum())
    storage_cost  = float(total_pick * AVG_DWELL_DAYS * STORAGE_EUR_PKG_DAY)
    total_cost    = fixed_cost + delivery_cost + storage_cost

    max_dist_km     = float(dist_km.max())
    avg_dist_km     = float(np.average(dist_km, weights=demand)) if demand.sum() > 0 else 0.0
    pickup_rate_net = total_pick / total_vol if total_vol > 0 else 0.0

    # ── 6. Weighted objective (cost + optional coverage penalty) ──────────────
    if lambda_dist > 0.0:
        threshold   = max_dist_threshold_km if max_dist_threshold_km is not None else 0.0
        excess      = np.maximum(0.0, dist_km - threshold)   # (n_sq,) km over threshold
        penalty_val = float(np.dot(excess, demand))           # demand-weighted excess km
        penalty     = lambda_dist * penalty_val
    else:
        penalty = 0.0

    objective = total_cost + penalty

    return EvaluationResult(
        objective        = objective,
        total_cost       = total_cost,
        fixed_cost       = fixed_cost,
        delivery_cost    = delivery_cost,
        storage_cost     = storage_cost,
        max_dist_km      = max_dist_km,
        avg_dist_km      = avg_dist_km,
        total_pickups    = total_pick,
        total_deliveries = total_del,
        pickup_rate_net  = pickup_rate_net,
        open_sp_indices  = list(map(int, indices)),
        open_sp_ids      = [net.sp_ids[i] for i in indices],
        n_open           = len(indices),
        sp_detail        = sp_detail,
    )


def evaluate_by_id(
    net: PostLNetwork,
    sp_id_list: List[int],
    lambda_dist: float = 0.0,
    max_dist_threshold_km: Optional[float] = None,
) -> EvaluationResult:
    """Convenience wrapper: evaluate using SP Location IDs instead of indices.

    Example
    -------
        result = evaluate_by_id(net, [4440, 1739, 753, 4387, 4431])
    """
    return evaluate(net, net.ids_to_indices(sp_id_list),
                    lambda_dist, max_dist_threshold_km)


