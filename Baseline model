# APL CANDIDATE SUPPORT  (new in v2)
# ══════════════════════════════════════════════════════════════════════════════

def add_apl_candidates(
    net: PostLNetwork,
    data_path: str,
    apl_xy: List[Tuple[float, float]],
    apl_ids: Optional[List] = None,
) -> PostLNetwork:
    """
    Extend the network with Automated Parcel Locker (APL) candidate locations.

    APLs are potential new pickup points that can be placed anywhere — typically
    at CBS square centroids in underserved or high-distance areas.  Once added,
    they become additional columns in the distance matrix and are treated exactly
    like SPs inside evaluate().

    This function re-uses the cached road graph from the original build by
    re-reading the Excel file and re-building the graph.  It only runs Dijkstra
    for the NEW APL nodes, so it is much faster than a full rebuild.

    Parameters
    ----------
    net : PostLNetwork
        The existing network (output of build_network or load_cache).
    data_path : str
        Path to data_Maastricht_2025.xlsx (needed to re-build the road graph).
    apl_xy : list of (x, y) tuples
        Coordinates of candidate APL locations (same coordinate system as the
        road network nodes and CBS squares).
    apl_ids : list, optional
        IDs for the APLs.  Defaults to ["APL_0", "APL_1", ...].

    Returns
    -------
    PostLNetwork
        A new PostLNetwork with APLs appended.  Original SP indices are
        unchanged (0–34).  APL indices start at 35.

    Example
    -------
    High-distance CBS squares identified in the EDA as underserved
    (all assigned to SP 5820, distances > 4 km):

        apl_positions = [
            (98158, 75000),   # near E1800N3220  (1,125 residents, 4.2 km)
            (103000, 72000),  # near E1805N3215  (1,115 residents, 4.6 km)
        ]
        net_with_apls = add_apl_candidates(net, "data_Maastricht_2025.xlsx",
                                            apl_positions)
        result = evaluate(net_with_apls, list(range(35)) + [35, 36])
    """
    if apl_ids is None:
        apl_ids = [f"APL_{i}" for i in range(len(apl_xy))]
    if len(apl_ids) != len(apl_xy):
        raise ValueError("apl_ids and apl_xy must have the same length.")

    print(f"[APL] Adding {len(apl_xy)} candidate APL location(s) …")

    # ── Rebuild road graph (directed, ONE_WAY-aware) ──────────────────────────
    xl    = pd.ExcelFile(data_path)
    nodes = pd.read_excel(xl, "Nodes")
    edges = pd.read_excel(xl, "Edges")

    G = nx.DiGraph()
    for _, r in nodes.iterrows():
        G.add_node(int(r["NODE ID"]), x=r["X"], y=r["Y"])
    for _, r in edges.iterrows():
        v1, v2, dist = int(r["V1"]), int(r["V2"]), float(r["DIST"])
        G.add_edge(v1, v2, weight=dist)
        if not bool(r["ONE_WAY"]):
            G.add_edge(v2, v1, weight=dist)
    G = G.subgraph(max(nx.weakly_connected_components(G), key=len)).copy()

    node_arr = np.array([[G.nodes[n]["x"], G.nodes[n]["y"]] for n in G.nodes()])
    node_ids = np.array(list(G.nodes()))

    def nearest_node(x: float, y: float) -> int:
        diffs = node_arr - np.array([x, y])
        return int(node_ids[np.argmin((diffs ** 2).sum(axis=1))])

    # ── Retrieve the CBS square nodes used during the original build ───────────
    cbs   = pd.read_excel(xl, "CBS Squares")
    cbs_pop = cbs[cbs["Population"].notna()].copy().reset_index(drop=True)
    cbs_pop["node"] = [nearest_node(r["X"], r["Y"]) for _, r in cbs_pop.iterrows()]
    sq_nodes = cbs_pop["node"].values
    n_sq = len(sq_nodes)

    # ── Run Dijkstra from each APL node ───────────────────────────────────────
    n_apl = len(apl_xy)
    apl_dist_matrix = np.full((n_sq, n_apl), np.inf)

    for j, (ax, ay) in enumerate(apl_xy):
        apl_node = nearest_node(ax, ay)
        dmap = nx.single_source_dijkstra_path_length(G, apl_node, weight="weight")
        for i, nd in enumerate(sq_nodes):
            apl_dist_matrix[i, j] = dmap.get(int(nd), np.inf)
        print(f"     APL {j+1}/{n_apl}  ({apl_ids[j]})  snapped to node {apl_node}")

    if np.isinf(apl_dist_matrix).any():
        max_finite = apl_dist_matrix[np.isfinite(apl_dist_matrix)].max()
        apl_dist_matrix = np.where(
            np.isinf(apl_dist_matrix), max_finite * 10, apl_dist_matrix
        )

    # ── Build APL metadata rows ───────────────────────────────────────────────
    apl_rows = []
    for j, (apl_id, (ax, ay)) in enumerate(zip(apl_ids, apl_xy)):
        col = net.n_sps + j
        apl_rows.append({
            "Location ID": apl_id,
            "X": ax,
            "Y": ay,
            "type": "APL",
            "total_parcels": 0.0,      # no observed history
            "avg_dist_km": float(
                np.average(apl_dist_matrix[:, j] / 1_000.0,
                           weights=net.sq_demand)
            ),
        })

    apl_df = pd.DataFrame(apl_rows)

    # ── Merge into existing network ───────────────────────────────────────────
    # Mark original SPs as type SP if column absent
    existing_df = net.sp_df.copy()
    if "type" not in existing_df.columns:
        existing_df["type"] = "SP"

    new_sp_df   = pd.concat([existing_df, apl_df], ignore_index=True)
    new_sp_ids  = net.sp_ids + list(apl_ids)
    new_dist_matrix = np.hstack([net.dist_matrix, apl_dist_matrix])

    print(f"[APL] Done.  Network now has {len(new_sp_ids)} candidate locations "
          f"({net.n_sps} SPs + {n_apl} APLs).")

    return PostLNetwork(
        sp_ids       = new_sp_ids,
        sp_df        = new_sp_df,
        sq_demand    = net.sq_demand,
        dist_matrix  = new_dist_matrix,
        annual_total = net.annual_total,
    )


