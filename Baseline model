"""
Post&L Maastricht — Baseline Model & Shared Optimization Scaffold
=================================================================
Author  : Hannes
Project : elab II Business Case #2

This module is the shared foundation for ALL optimization methods in the group:
  Niklas    — Greedy heuristic
  Nicola    — Local search / swap heuristic
  Tristan   — Simulated annealing
  Elizaveta — Genetic algorithm
  Beliz     — Mixed-integer (MILP) facility location

PUBLIC API (what other team members need)
-----------------------------------------
  # Step 1 — build once and cache (takes ~30–60 s for Dijkstra)
  net = build_network("data_Maastricht_2025.xlsx")
  net.save_cache("postl_cache.pkl")

  # Step 2 — fast reload every subsequent run (< 1 s)
  net = PostLNetwork.load_cache("postl_cache.pkl")

  # Step 3 — evaluate any candidate solution
  result = evaluate(net, [0, 1, 4, 7, ...])          # list of SP indices (0–34)
  result = evaluate_by_id(net, [4440, 1739, 753, ...]) # or by Location ID

  # Step 4 — compare against baseline
  ref = baseline_all_open(net)                        # 35-SP status quo
  print(f"Your saving: €{ref.total_cost - result.total_cost:,.0f}")

WEIGHTED OBJECTIVE
------------------
  By default the objective is pure cost minimisation.
  Pass lambda_dist > 0 to add a coverage penalty:

      objective = total_cost
                + lambda_dist × sum_over_squares(max(0, dist_km − threshold) × sq_demand)

  This penalises squares whose nearest open SP exceeds `max_dist_threshold_km`.
  The penalty is demand-weighted so densely populated squares matter more.

PARETO ANALYSIS
---------------
  Use pareto_frontier(results) to extract non-dominated solutions from any
  collection of EvaluationResults.

COST MODEL (confirmed with client)
-----------------------------------
  Fixed cost  : €50,000 per open SP per year
  Delivery    : €1.50 per km  (distance from CBS square centroid to SP)
  Storage     : €0.10 per package per day × 2 days assumed dwell time
  Pickup rate : logistic decay  p(d) = 1 / (1 + exp(0.562 × (d − 2.04)))
                fitted in Milestone 1 (d in km)
"""

import os
import pickle
import warnings
from dataclasses import dataclass, field
from typing import Dict, List, Optional, Tuple

import networkx as nx
import numpy as np
import pandas as pd

warnings.filterwarnings("ignore")

# ── Cost parameters ────────────────────────────────────────────────────────────
FIXED_COST_EUR       = 50_000  # € per SP per year
DELIVERY_EUR_PER_KM  = 1.50    # € per km
STORAGE_EUR_PKG_DAY  = 0.10    # € per package per day in storage
AVG_DWELL_DAYS       = 2       # assumed average dwell time (days)

# ── Pickup-rate logistic model (fitted in Milestone 1) ─────────────────────────
LOGISTIC_K  = 0.562  # decay steepness
LOGISTIC_D0 = 2.04   # 50 % crossover distance (km)


def pickup_rate(d_km: np.ndarray) -> np.ndarray:
    """Logistic pickup probability as a function of road distance to SP (km).

    Fitted in Milestone 1:  p(d) = 1 / (1 + exp(0.562 × (d − 2.04)))
    At d=0 km  →  p ≈ 0.94  (very likely to pick up if SP is on your doorstep)
    At d=2.04 km →  p = 0.50  (crossover point)
    At d=5 km  →  p ≈ 0.10  (most customers prefer home delivery)
    """
    return 1.0 / (1.0 + np.exp(LOGISTIC_K * (d_km - LOGISTIC_D0)))


