@dataclass
class PostLNetwork:
    """
    Precomputed network representation of the Post&L Maastricht problem.

    Build once with build_network(), save with save_cache(), and reload with
    PostLNetwork.load_cache() — all subsequent evaluate() calls are pure numpy
    with no graph operations.

    Attributes
    ----------
    sp_ids : list[int]
        Location IDs of all 35 candidate service points.
        The index of a Location ID in this list is its *SP index* (0–34).
        dist_matrix column j corresponds to sp_ids[j].
    sp_df : DataFrame
        SP metadata: Location ID, X, Y, total_parcels (observed), avg_dist_km.
    sq_demand : ndarray, shape (n_squares,)
        Estimated annual parcel demand per CBS square.
        Derived by distributing each SP's observed annual volume to its
        Voronoi squares, weighted by household count.
        sum(sq_demand) ≈ total observed annual parcels.
    dist_matrix : ndarray, shape (n_squares, 35), dtype float64
        Road distances in **metres** from each CBS square's nearest road node
        to each SP's nearest road node, via Dijkstra shortest paths.
        dist_matrix[i, j] = distance from square i to SP j.
    annual_total : float
        Total observed annual parcels across all 35 SPs (for reference).
    """
    sp_ids:       List[int]
    sp_df:        pd.DataFrame
    sq_demand:    np.ndarray
    dist_matrix:  np.ndarray   # metres
    annual_total: float

    # ── Serialisation ─────────────────────────────────────────────────────────
    def save_cache(self, path: str = "postl_cache.pkl") -> None:
        """Pickle the precomputed network to skip Dijkstra on next run."""
        with open(path, "wb") as f:
            pickle.dump(self, f)
        print(f"[cache] Saved → {path}")

    @classmethod
    def load_cache(cls, path: str = "postl_cache.pkl") -> "PostLNetwork":
        """Load a previously cached network (fast, no Dijkstra needed)."""
        with open(path, "rb") as f:
            obj = pickle.load(f)
        print(f"[cache] Loaded ← {path}  "
              f"({obj.n_sps} SPs, {obj.n_squares} squares)")
        return obj

    # ── Convenience properties ────────────────────────────────────────────────
    @property
    def n_sps(self) -> int:
        """Total number of candidate service points (35)."""
        return len(self.sp_ids)

    @property
    def n_squares(self) -> int:
        """Number of CBS squares with population data."""
        return self.dist_matrix.shape[0]

    def idx_of(self, sp_id: int) -> int:
        """Return the column index (0–34) of a given SP Location ID."""
        return self.sp_ids.index(sp_id)

    def ids_to_indices(self, sp_id_list: List[int]) -> List[int]:
        """Convert a list of SP Location IDs to column indices."""
        return [self.idx_of(sid) for sid in sp_id_list]

    def indices_to_ids(self, indices: List[int]) -> List[int]:
        """Convert a list of column indices to SP Location IDs."""
        return [self.sp_ids[i] for i in indices]


