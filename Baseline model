# NETWORK BUILDER  (run once, then use cache)
# ══════════════════════════════════════════════════════════════════════════════

def build_network(data_path: str) -> PostLNetwork:
    """
    Load data from Excel, build road network, precompute all distance matrices,
    and estimate annual demand per CBS square.

    ⚠ This function takes ~30–60 seconds (35 × Dijkstra on 8k-node graph).
    After calling this once, save the result and use load_cache() instead:

        net = build_network("data_Maastricht_2025.xlsx")
        net.save_cache("postl_cache.pkl")

        # All subsequent runs:
        net = PostLNetwork.load_cache("postl_cache.pkl")

    Parameters
    ----------
    data_path : str
        Path to data_Maastricht_2025.xlsx.

    Returns
    -------
    PostLNetwork
    """
    # ── 0. Load all sheets ────────────────────────────────────────────────────
    print("=" * 60)
    print("  POST&L MAASTRICHT — BUILDING NETWORK")
    print("=" * 60)
    print(f"\n[1/5] Loading data from {data_path} …")

    xl    = pd.ExcelFile(data_path)
    sp    = pd.read_excel(xl, "Service Point Locations")
    da    = pd.read_excel(xl, "Daily Activity")
    nodes = pd.read_excel(xl, "Nodes")
    edges = pd.read_excel(xl, "Edges")
    cbs   = pd.read_excel(xl, "CBS Squares")

    # Keep only CBS squares with population data
    cbs_pop = cbs[cbs["Population"].notna()].copy().reset_index(drop=True)
    print(f"     {len(sp)} SPs · {len(da):,} activity records · "
          f"{len(nodes):,} nodes · {len(edges):,} edges · {len(cbs_pop)} CBS squares")

    # ── 1. Build road-network graph ───────────────────────────────────────────
    print("\n[2/5] Building road network graph …")
    # CHANGE v2: Use a directed graph (DiGraph) and respect the ONE_WAY flag.
    # The original baseline used an undirected Graph, silently treating every
    # road as bidirectional.  21 % of edges are one-way, which caused the
    # max-distance figure to differ from other team members' analyses.
    # Approach (matching Nicola's Python and Beliz's R):
    #   - Every edge is added in the forward direction V1 → V2.
    #   - Two-way roads (ONE_WAY == False) also get a reverse edge V2 → V1.
    G = nx.DiGraph()
    for _, r in nodes.iterrows():
        G.add_node(int(r["NODE ID"]), x=r["X"], y=r["Y"])
    for _, r in edges.iterrows():
        v1, v2, dist = int(r["V1"]), int(r["V2"]), float(r["DIST"])
        G.add_edge(v1, v2, weight=dist)
        if not bool(r["ONE_WAY"]):          # two-way road → add reverse edge
            G.add_edge(v2, v1, weight=dist)

    # Take largest weakly-connected component (consistent with undirected baseline)
    G = G.subgraph(
        max(nx.weakly_connected_components(G), key=len)
    ).copy()
    print(f"     Largest WCC: {G.number_of_nodes():,} nodes, "
          f"{G.number_of_edges():,} edges  "
          f"({edges['ONE_WAY'].mean():.1%} of original edges are one-way)")

    # ── 2. Map SPs and CBS squares to nearest road node ───────────────────────
    print("\n[3/5] Snapping SPs and CBS squares to road nodes …")
    node_arr = np.array([[G.nodes[n]["x"], G.nodes[n]["y"]] for n in G.nodes()])
    node_ids = np.array(list(G.nodes()))

    def nearest_node(x: float, y: float) -> int:
        diffs = node_arr - np.array([x, y])
        return int(node_ids[np.argmin((diffs ** 2).sum(axis=1))])

    sp["node"]      = [nearest_node(r["X"], r["Y"]) for _, r in sp.iterrows()]
    cbs_pop["node"] = [nearest_node(r["X"], r["Y"]) for _, r in cbs_pop.iterrows()]

    # ── 3. Dijkstra from every SP → distance matrix ───────────────────────────
    print("\n[4/5] Running Dijkstra from each SP (≈30–60 s) …")
    sp_ids   = sp["Location ID"].tolist()
    sq_nodes = cbs_pop["node"].values
    n_sq     = len(cbs_pop)
    n_sp     = len(sp_ids)

    dist_matrix = np.full((n_sq, n_sp), np.inf)

    for j, (_, row) in enumerate(sp.iterrows()):
        dmap = nx.single_source_dijkstra_path_length(G, row["node"], weight="weight")
        for i, nd in enumerate(sq_nodes):
            dist_matrix[i, j] = dmap.get(int(nd), np.inf)
        if (j + 1) % 5 == 0 or j == n_sp - 1:
            print(f"     SP {j+1:2d}/{n_sp} complete")

    # Resolve any inf values (disconnected squares) with large finite distance
    if np.isinf(dist_matrix).any():
        n_inf = np.isinf(dist_matrix).sum()
        fallback = dist_matrix[np.isfinite(dist_matrix)].max() * 2.0
        dist_matrix = np.where(np.isinf(dist_matrix), fallback, dist_matrix)
        print(f"     ⚠ {n_inf} inf values replaced with {fallback/1000:.1f} km fallback")

    # ── 4. Estimate demand per CBS square ─────────────────────────────────────
    print("\n[5/5] Estimating square-level demand …")

    # Annual volumes from observed activity data
    annual = (
        da.groupby("Location ID")
        .agg(total_deliveries=("Deliveries", "sum"),
             total_pickups   =("Pickups",    "sum"))
        .reset_index()
    )
    annual["total_parcels"] = annual["total_deliveries"] + annual["total_pickups"]
    annual_total = float(annual["total_parcels"].sum())

    # CHANGE v2: Population-proportional demand distribution.
    # Original: distributed each SP's observed volume to its Voronoi squares
    #           proportionally by household count.
    # Updated:  distribute total network demand proportionally to population
    #           directly — consistent with the EDA finding that
    #           "Population is the primary variable" (slide 11) and with
    #           Nicola's demand model (demand_sq = population × demand_factor).
    #
    # demand_factor = total_annual_parcels / total_population
    # demand_sq[i]  = population[i] × demand_factor
    total_population = float(cbs_pop["Population"].sum())
    demand_factor    = annual_total / total_population
    sq_demand        = cbs_pop["Population"].values * demand_factor

    print(f"     Population: {total_population:,.0f} residents  |  "
          f"demand factor: {demand_factor:.4f} parcels/resident/year")
    print(f"     Demand distributed: {sq_demand.sum():,.0f} parcels "
          f"(observed: {annual_total:,.0f}  ·  diff: "
          f"{abs(sq_demand.sum() - annual_total)/annual_total:.1%})")

    # ── 5. Compute SP-level avg distances for reference ───────────────────────
    sp_aug = sp.merge(annual, on="Location ID", how="left").fillna(0)
    nearest_col = dist_matrix.argmin(axis=1)   # current Voronoi (all 35 open)
    for j, sid in enumerate(sp_ids):
        mask = nearest_col == j
        if mask.any() and cbs_pop.loc[mask, "Population"].sum() > 0:
            sp_aug.loc[sp_aug["Location ID"] == sid, "avg_dist_km"] = np.average(
                dist_matrix[mask, j] / 1_000.0,
                weights=cbs_pop.loc[mask, "Population"],
            )
        else:
            sp_aug.loc[sp_aug["Location ID"] == sid, "avg_dist_km"] = np.nan

    sp_aug = sp_aug.reset_index(drop=True)

    print("\n✓ Network ready.\n")
    return PostLNetwork(
        sp_ids       = sp_ids,
        sp_df        = sp_aug,
        sq_demand    = sq_demand,
        dist_matrix  = dist_matrix,
        annual_total = annual_total,
    )


