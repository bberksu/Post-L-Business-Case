# BASELINE SOLUTION BUILDERS
# ══════════════════════════════════════════════════════════════════════════════

def baseline_all_open(net: PostLNetwork, **eval_kwargs) -> EvaluationResult:
    """
    Baseline A — Status quo: all 35 SPs open.

    This is the **reference benchmark**.  Every other solution should be
    compared against this.  The gap (ref.total_cost − result.total_cost)
    is the annual saving your method achieves.
    """
    return evaluate(net, list(range(net.n_sps)), **eval_kwargs)


def baseline_top_k(net: PostLNetwork, k: int, **eval_kwargs) -> EvaluationResult:
    """
    Baseline B — Open only the top-K SPs by observed annual parcel volume.

    A simple rule-based greedy reduction: keep the busiest SPs, drop the rest.
    This is naive (ignores geography) but gives a fast cost-curve upper bound.

    Parameters
    ----------
    k : int
        Number of SPs to open (1 ≤ k ≤ 35).
    """
    if not (1 <= k <= net.n_sps):
        raise ValueError(f"k must be in [1, {net.n_sps}], got {k}.")
    top_k_ids = (
        net.sp_df
        .nlargest(k, "total_parcels")["Location ID"]
        .tolist()
    )
    return evaluate(net, net.ids_to_indices(top_k_ids), **eval_kwargs)


def sweep_k(
    net: PostLNetwork,
    lambda_dist: float = 0.0,
    max_dist_threshold_km: Optional[float] = None,
    verbose: bool = True,
) -> pd.DataFrame:
    """
    Evaluate baseline_top_k for every k from 1 to 35.

    Returns a DataFrame with cost components and coverage metrics for each k.
    Useful for plotting the cost-vs-coverage trade-off curve and identifying
    the 'elbow' (optimal k for pure cost minimisation).
    """
    rows = []
    for k in range(1, net.n_sps + 1):
        r = baseline_top_k(net, k,
                           lambda_dist=lambda_dist,
                           max_dist_threshold_km=max_dist_threshold_km)
        rows.append({
            "k":             k,
            "objective":     r.objective,
            "total_cost":    r.total_cost,
            "fixed_cost":    r.fixed_cost,
            "delivery_cost": r.delivery_cost,
            "storage_cost":  r.storage_cost,
            "max_dist_km":   r.max_dist_km,
            "avg_dist_km":   r.avg_dist_km,
            "pickup_rate":   r.pickup_rate_net,
        })
        if verbose:
            tag = " ← STATUS QUO" if k == 35 else ""
            print(f"  k={k:2d}  cost=€{r.total_cost:>9,.0f}  "
                  f"max_dist={r.max_dist_km:5.2f} km  "
                  f"pickup={r.pickup_rate_net:.1%}{tag}")

    return pd.DataFrame(rows)


