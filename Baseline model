# PARETO UTILITIES
# ══════════════════════════════════════════════════════════════════════════════

def pareto_frontier(
    results: List[EvaluationResult],
    obj1: str = "total_cost",
    obj2: str = "max_dist_km",
) -> List[EvaluationResult]:
    """
    Extract Pareto-optimal solutions from a list of EvaluationResults.

    Both objectives are minimised.  Default: total_cost vs max_dist_km.

    A solution is Pareto-optimal if no other solution is at least as good on
    both objectives and strictly better on at least one.

    Parameters
    ----------
    results : list[EvaluationResult]
        Any collection of evaluated solutions (from sweep, SA, GA, etc.).
    obj1 : str
        First attribute to minimise (default: "total_cost").
    obj2 : str
        Second attribute to minimise (default: "max_dist_km").

    Returns
    -------
    list[EvaluationResult]
        Pareto-optimal subset, sorted by obj1 ascending.

    Example
    -------
        all_results = [evaluate(net, sample()) for _ in range(1000)]
        front = pareto_frontier(all_results)
    """
    vals = np.array([(getattr(r, obj1), getattr(r, obj2)) for r in results])
    n = len(results)
    dominated = np.zeros(n, dtype=bool)

    for i in range(n):
        for j in range(n):
            if i == j:
                continue
            # j dominates i if it is ≤ on both and < on at least one
            if (vals[j, 0] <= vals[i, 0] and vals[j, 1] <= vals[i, 1] and
                    (vals[j, 0] < vals[i, 0] or vals[j, 1] < vals[i, 1])):
                dominated[i] = True
                break

    pareto = [r for r, d in zip(results, dominated) if not d]
    pareto.sort(key=lambda r: getattr(r, obj1))
    return pareto


